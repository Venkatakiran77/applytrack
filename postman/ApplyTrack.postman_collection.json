            "url": "{{baseUrl}}/api/applications",
            "auth": {
              "type": "inherit"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Example Company\",\n  \"position\": \"Software Engineer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update application status (adjust path if needed)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/applications/1/status",
            "auth": {
              "type": "inherit"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPLIED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete application",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/applications/1",
            "auth": {
              "type": "inherit"
            }
          }
        }
      ]
    },
    {
      "name": "Skills",
      "item": [
        {
          "name": "Get skills (adjust route)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/skills",
            "auth": {
              "type": "inherit"
            }
          }
        }
      ]
    },
    {
      "name": "Match",
      "item": [
        {
          "name": "Match application (adjust body to your API)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/applications/1/match",
            "auth": {
              "type": "inherit"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jdText\": \"Java developer with Spring Boot and REST API experience\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dashboard",
            "auth": {
              "type": "inherit"
            }
          }
        }
      ]
    }
  ]
}